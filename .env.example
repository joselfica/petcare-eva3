# ============================================================================
# .env.example — PetCare EVA3
# ----------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiar a `.env` y completar con valores
# reales. El archivo `.env` NO se versiona (ver .gitignore).
# ============================================================================

# Seguridad Django — generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplazar-con-clave-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a PostgreSQL
# Desarrollo local: DB_HOST=localhost
# AWS EC2: DB_HOST=localhost (PostgreSQL corre en la misma instancia)
DB_NAME=petcare_db
DB_USER=petcare_user
DB_PASSWORD=petcare_pass_2024
DB_HOST=localhost
DB_PORT=5432